# J.A.R.V.I.S. backend configuration
APP_ENV=development
APP_NAME=JARVIS Backend
HOST=127.0.0.1
PORT=8000
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=1800
PAIRING_TTL_SECONDS=300
REPLAY_WINDOW_SECONDS=120

# Comma-separated normalized identities. Keep actual values in deployment secrets.
APPROVED_EMAILS=
APPROVED_GITHUB_USERS=
APPROVED_MICROSOFT_EMAILS=
APPROVED_YAHOO_EMAILS=
ADMIN_IDENTITIES=

# Provider credentials: backend-only, never ship to clients.
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public OAuth client IDs may be configured here; client secrets remain backend-only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000/api/v1/auth/oauth

# Local AI integration metadata. The local service itself should bind to loopback.
LOCAL_AI_HOST=127.0.0.1
LOCAL_AI_PORT=11435
LLAMA_CPP_EXECUTABLE=
LLAMA_CPP_MODEL=
